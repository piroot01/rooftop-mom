%
% commands for custom titles
%

% entry
\newcounter{entry}[subsection]
\newcommand{\entryTitle}[2] {%
    \refstepcounter{entry}%
    \label{entry:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Entry \thesection.\arabic{entry} (#1).}%
}


% proposition
\newcounter{prop}[subsection]
\newcommand{\propTitle}[2] {%
    \refstepcounter{prop}%
    \label{prop:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Proposition \thesection.\arabic{prop} (#1).}%
}

% corollary
\newcounter{coro}[subsection]
\newcommand{\coroTitle}[2] {%
    \refstepcounter{coro}%
    \label{coro:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Corollary \thesection.\arabic{coro} (#1).}%
}


% theorem
\newcounter{theo}[subsection]
\newcommand{\theoTitle}[2] {%
    \refstepcounter{theo}%
    \label{theo:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Theorem \thesection.\arabic{theo} (#1).}%
}


% lemma
\newcounter{lemma}[subsection]
\newcommand{\lemmaTitle}[2] {%
    \refstepcounter{lemma}%
    \label{lemma:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Lemma \thesection.\arabic{lemma} (#1).}%
}


% definition
\newcounter{def}[subsection]
\newcommand{\defTitle}[2] {%
    \refstepcounter{def}%
    \label{def:#2}%
    \vspace{\baselineskip}
    \noindent\textbf{Definition \thesection.\arabic{def} (#1).}%
}

\renewcommand{\theentry}{\thesection.\arabic{entry}}
\renewcommand{\theprop}{\thesection.\arabic{prop}}
\renewcommand{\thecoro}{\thesection.\arabic{coro}}
\renewcommand{\thetheo}{\thesection.\arabic{theo}}
\renewcommand{\thelemma}{\thesection.\arabic{lemma}}
\renewcommand{\thedef}{\thesection.\arabic{def}}

\newcommand{\entryRef}[1]{(\hyperref[entry:#1]{\ref*{entry:#1}})}
\newcommand{\propRef}[1]{(\hyperref[prop:#1]{\ref*{prop:#1}})}
\newcommand{\coroRef}[1]{(\hyperref[coro:#1]{\ref*{coro:#1}})}
\newcommand{\theoRef}[1]{(\hyperref[theo:#1]{\ref*{theo:#1}})}
\newcommand{\lemmaRef}[1]{(\hyperref[lemma:#1]{\ref*{lemma:#1}})}
\newcommand{\defRef}[1]{(\hyperref[def:#1]{\ref*{def:#1}})}

